{
  "name": "lus222-jev-challenge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "O JEV (typesafe-ai/jev) decide e desvia o LUS-222 — cenário CEiiA/EEA Aircraft. Evasão autónoma visível, não DAA certificável. A regra geométrica nunca se vende como JEV.",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "node scripts/verify-deploy-assets.mjs",
    "dev": "npx --yes serve public -l 43123",
    "preview": "vercel dev --listen 43123",
    "test": "node --test lib/*.test.mjs",
    "lint": "eslint api lib public/src scripts",
    "replays:record": "node scripts/record-replays.mjs http://localhost:43123",
    "counterfactuals:check": "node scripts/check-counterfactuals.mjs http://localhost:43123",
    "avaliar": "node --env-file=.env scripts/avaliar-jev.mjs",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "ai": "^7.0.148"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
