# Chave do Vercel AI Gateway (Dashboard > AI Gateway > API Keys).
# Em produção na Vercel, com o AI Gateway activo no projecto, o OIDC dispensa esta variável.
# Sem esta chave a missão JEV não arranca — a regra geométrica nunca se vende como JEV.
AI_GATEWAY_API_KEY=

# Opcional: avaliações por minuto e por IP (default 400).
JEV_RATE_LIMIT_PER_MIN=400
